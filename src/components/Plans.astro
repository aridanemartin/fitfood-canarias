---
import { getContent } from "../data/content";
import { useTranslations } from "../i18n";
import type { Lang } from "../i18n/locales";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { plans } = getContent(lang);
---

<section id="plans" class="section section--onlight plans">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{t("plans.eyebrow")}</p>
      <h2>{t("plans.heading")}</h2>
      <p>{t("plans.intro")}</p>
    </div>

    <div class="plans__grid">
      {
        plans.map((plan) => (
          <article class="plan-card reveal">
            <div class="plan-card__media">
              <img src={plan.image} alt={plan.imageAlt} loading="lazy" />
            </div>
            <div class="plan-card__body">
              <p class="plan-card__macro">{plan.macroLabel}</p>
              <h3 class="plan-card__name">{plan.name}</h3>
              <p class="plan-card__desc">{plan.description}</p>
              <p class="plan-card__best">{plan.bestFor}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .plans__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 1.5rem);
  }

  .plan-card {
    background: var(--color-ink);
    color: var(--color-text-ondark);
    border-radius: var(--radius-container);
    overflow: hidden;
    border-top: 4px solid var(--accent);
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .plan-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 34px -18px rgba(0, 0, 0, 0.55);
  }

  .plan-card__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .plan-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .plan-card__body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .plan-card__macro {
    font-family: var(--font-data);
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .plan-card__name {
    font-size: 1.4rem;
  }

  .plan-card__desc {
    color: var(--color-text-ondark-muted);
    font-size: 0.96rem;
    flex: 1;
  }

  .plan-card__best {
    margin-top: 0.4rem;
    font-size: 0.85rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-text-ondark);
  }

  @media (max-width: 900px) {
    .plans__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
