---
import { site } from "../data/content";
---

<section id="contact" class="section section--onlight contact">
  <div class="wrap contact__grid">
    <div class="reveal">
      <p class="eyebrow">Get your first delivery</p>
      <h2>Tell the kitchen which plan, we'll handle the rest.</h2>
      <p class="contact__sub">
        Call or email to set your gender and objective — your first box ships within the week.
      </p>
      <div class="contact__ctas">
        <a class="btn btn--primary btn--onlight" href={`tel:${site.phone.replace(/\s/g, "")}`}>
          Call {site.phone}
        </a>
        <a class="btn btn--ghost btn--onlight" href={`mailto:${site.email}`}>Email the kitchen</a>
      </div>
    </div>

    <dl class="contact__details reveal">
      <div>
        <dt>Kitchen</dt>
        <dd>{site.address}</dd>
      </div>
      <div>
        <dt>Phone</dt>
        <dd>{site.phone}</dd>
      </div>
      <div>
        <dt>Email</dt>
        <dd>{site.email}</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.7fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .contact h2 {
    margin-top: 0.6rem;
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    max-width: 18ch;
  }

  .contact__sub {
    margin-top: 1rem;
    color: var(--color-text-onlight-muted);
    max-width: 44ch;
  }

  .contact__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2rem;
  }

  .btn--onlight.btn--primary {
    background: var(--color-ink);
    color: var(--color-panel);
  }

  .btn--onlight.btn--ghost {
    border-color: var(--color-line-onlight);
    color: var(--color-text-onlight);
  }

  .btn--onlight.btn--ghost:hover {
    border-color: var(--accent-fatloss);
    color: var(--accent-fatloss);
  }

  .contact__details {
    background: var(--color-ink);
    color: var(--color-text-ondark);
    border-radius: var(--radius-container);
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .contact__details dt {
    font-family: var(--font-data);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--accent-gain);
    margin-bottom: 0.3rem;
  }

  .contact__details dd {
    margin: 0;
    font-size: 0.98rem;
  }

  @media (max-width: 760px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
