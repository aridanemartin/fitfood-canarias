---
import { site, nav } from "../data/content";
import { useTranslations } from "../i18n";
import type { Lang } from "../i18n/locales";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

// Social links aren't real yet — the icons are decorative placeholders
// (no href) so we don't ship dead links. Swap in real profile URLs and
// turn each into an <a> once accounts exist.
const socialIcons = [
  { label: "Instagram", path: "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z" },
  { label: "Facebook", path: "M4 4h16a4 4 0 0 1 4 4v8a4 4 0 0 1-4 4H4a4 4 0 0 1-4-4V8a4 4 0 0 1 4-4z" },
  { label: "Newsletter", path: "M3 12l18-9-6 18-4-8-8-1z" },
];
---

<footer class="footer">
  <div class="wrap">
    <div class="footer__grid">
      <div class="footer__brand">
        <img src={site.logo} alt={site.name} class="footer__logo" />
        <p class="footer__tagline">{t("footer.tagline")}</p>
        <p class="footer__disclaimer">{t("footer.disclaimer")}</p>
      </div>

      <nav aria-label={t("nav.label")}>
        <h3>{t("footer.navHeading")}</h3>
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href}>{t(item.key)}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h3>{t("footer.contactHeading")}</h3>
        <ul>
          <li>
            <a href={`tel:${site.phone.replace(/\s/g, "")}`}>{site.phone}</a>
          </li>
          <li>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>{site.address}</li>
        </ul>
      </div>

      <div>
        <h3>{t("footer.followHeading")}</h3>
        <div class="footer__socials">
          {
            socialIcons.map((icon) => (
              <span class="footer__social" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d={icon.path} />
                </svg>
              </span>
            ))
          }
        </div>
        <p class="footer__socialsNote">{t("footer.socialsComingSoon")}</p>
      </div>
    </div>

    <div class="footer__bottom">
      <p class="footer__copy">{t("footer.copy", { year })}</p>
      <p class="footer__madeIn">{t("footer.madeIn")}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(2.5rem, 5vw, 3.5rem) 2rem;
    border-top: 1px solid var(--color-line);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr 0.9fr 0.9fr;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    padding-bottom: 2.2rem;
    border-bottom: 1px solid var(--color-line);
  }

  .footer__logo {
    height: 40px;
    width: auto;
  }

  .footer__tagline {
    margin: 1rem 0 0;
    font-family: var(--font-display);
    font-size: 1.02rem;
    max-width: 26ch;
  }

  .footer__disclaimer {
    margin-top: 0.9rem;
    max-width: 34ch;
    font-size: 0.8rem;
    color: var(--color-text-ondark-muted);
  }

  .footer__grid h3 {
    font-family: var(--font-data);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-ondark-muted);
    margin: 0 0 1rem;
  }

  .footer__grid ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    font-size: 0.9rem;
  }

  .footer__grid a {
    text-decoration: none;
    color: var(--color-text-ondark-muted);
    transition: color 0.15s ease;
  }

  .footer__grid a:hover {
    color: var(--accent);
  }

  .footer__socials {
    display: flex;
    gap: 0.6rem;
  }

  .footer__social {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--color-line);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-ondark-muted);
  }

  .footer__social svg {
    width: 15px;
    height: 15px;
    fill: currentColor;
  }

  .footer__socialsNote {
    margin: 0.8rem 0 0;
    font-size: 0.78rem;
    color: var(--color-text-ondark-muted);
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 1.5rem;
  }

  .footer__copy,
  .footer__madeIn {
    margin: 0;
    font-family: var(--font-data);
    font-size: 0.76rem;
    color: var(--color-text-ondark-muted);
  }

  @media (max-width: 860px) {
    .footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
