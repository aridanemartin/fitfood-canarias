---
import { site, nav } from "../data/content";
import { useTranslations } from "../i18n";
import type { Lang } from "../i18n/locales";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer__row">
    <div>
      <p class="footer__brand">{site.name}</p>
      <p class="footer__disclaimer">{t("footer.disclaimer")}</p>
    </div>

    <nav aria-label={t("nav.label")}>
      <ul class="footer__nav">
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>{t(item.key)}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="footer__copy">{t("footer.copy", { year })}</p>
  </div>
</footer>

<style>
  .footer {
    padding-block: 2.5rem;
    border-top: 1px solid var(--color-line);
  }

  .footer__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .footer__brand {
    font-family: var(--font-display);
    font-weight: 600;
  }

  .footer__disclaimer {
    margin-top: 0.4rem;
    max-width: 42ch;
    font-size: 0.82rem;
    color: var(--color-text-ondark-muted);
  }

  .footer__nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer__nav a {
    text-decoration: none;
    font-size: 0.88rem;
    color: var(--color-text-ondark-muted);
  }

  .footer__nav a:hover {
    color: var(--color-text-ondark);
  }

  .footer__copy {
    font-family: var(--font-data);
    font-size: 0.78rem;
    color: var(--color-text-ondark-muted);
    align-self: flex-end;
  }
</style>
