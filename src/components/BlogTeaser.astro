---
import { getContent } from "../data/content";
import { useTranslations } from "../i18n";
import type { Lang } from "../i18n/locales";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { blogPosts } = getContent(lang);
---

<section class="section blog">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{t("blog.eyebrow")}</p>
      <h2>{t("blog.heading")}</h2>
    </div>

    <div class="blog__grid">
      {
        blogPosts.map((post) => (
          <article class="blog__card reveal">
            <h3 class="blog__title">{post.title}</h3>
            <p class="blog__excerpt">{post.excerpt}</p>
            <span class="blog__link">{t("blog.read")}</span>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .blog__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 1.5rem);
  }

  .blog__card {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-container);
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    transition: border-color 0.15s ease;
  }

  .blog__card:hover {
    border-color: var(--accent);
  }

  .blog__title {
    font-size: 1.1rem;
  }

  .blog__excerpt {
    color: var(--color-text-ondark-muted);
    font-size: 0.95rem;
    flex: 1;
  }

  .blog__link {
    font-family: var(--font-data);
    font-size: 0.78rem;
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .blog__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
