---
import { getContent, founderProfile } from "../data/content";
import { useTranslations } from "../i18n";
import type { Lang } from "../i18n/locales";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { founderParagraphs } = getContent(lang);
---

<section id="about" class="section section--onlight founder">
  <div class="wrap founder__grid">
    <div class="founder__photo reveal">
      <img
        src={founderProfile.photo}
        alt={t("founder.photoAlt", { name: founderProfile.name })}
        loading="lazy"
      />
    </div>

    <div class="founder__copy reveal">
      <p class="eyebrow">{t("founder.eyebrow")}</p>
      <h2>{t("founder.headline")}</h2>
      {founderParagraphs.map((p) => <p class="founder__p">{p}</p>)}

      <div class="founder__sign">
        <img
          src={founderProfile.signature}
          alt={t("founder.signAlt", { name: founderProfile.name })}
          class="founder__sign-img"
          loading="lazy"
        />
        <span class="founder__sign-caption">
          {founderProfile.name}, {t("founder.role")}
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .founder__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .founder__photo {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-container);
    overflow: hidden;
    background: var(--color-line-onlight);
  }

  .founder__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .founder h2 {
    margin-top: 0.6rem;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    max-width: 18ch;
  }

  .founder__p {
    margin-top: 1.1rem;
    max-width: 56ch;
    color: var(--color-text-onlight-muted);
    font-size: 1.02rem;
  }

  .founder__sign {
    margin-top: 2rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .founder__sign-img {
    height: 56px;
    width: auto;
  }

  .founder__sign-caption {
    font-family: var(--font-data);
    font-size: 0.78rem;
    color: var(--color-text-onlight-muted);
    border-left: 1px solid var(--color-line-onlight);
    padding-left: 1rem;
  }

  @media (max-width: 760px) {
    .founder__grid {
      grid-template-columns: 1fr;
    }

    .founder__photo {
      aspect-ratio: 16 / 10;
      max-width: 360px;
    }
  }
</style>
