---
import { getContent } from "../data/content";
import { useTranslations } from "../i18n";
import type { Lang } from "../i18n/locales";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { testimonials } = getContent(lang);

function initials(name: string) {
  return name
    .split(" ")
    .map((part) => part[0])
    .join("");
}
---

<section class="section section--onlight testimonials">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{t("testimonials.eyebrow")}</p>
      <h2>{t("testimonials.heading")}</h2>
      <p>{t("testimonials.note")}</p>
    </div>

    <div class="testimonials__grid">
      {
        testimonials.map((item) => (
          <figure class="testimonial reveal">
            <span class="testimonial__stars">
              <span class="visually-hidden">{t("testimonials.rating")}</span>
              {Array.from({ length: 5 }).map(() => (
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M10 1l2.8 6 6.6.6-5 4.4 1.5 6.4L10 15l-5.9 3.4L5.6 12l-5-4.4 6.6-.6z" />
                </svg>
              ))}
            </span>
            <blockquote>"{item.quote}"</blockquote>
            <figcaption>
              <span class="testimonial__avatar">{initials(item.name)}</span>
              <span>
                <span class="testimonial__name">{item.name}</span>
                <span class="testimonial__role">{item.role}</span>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .testimonials__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 1.5rem);
  }

  .testimonial {
    margin: 0;
    background: var(--color-ink);
    color: var(--color-text-ondark);
    border-radius: var(--radius-container);
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 1.3rem;
  }

  .testimonial__stars {
    display: inline-flex;
    gap: 2px;
    margin-bottom: -0.6rem;
  }

  .testimonial__stars svg {
    width: 15px;
    height: 15px;
    fill: var(--accent);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .testimonial blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.08rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .testimonial figcaption {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.85rem;
  }

  .testimonial__avatar {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--accent);
    color: var(--color-ink);
    font-family: var(--font-data);
    font-size: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .testimonial__name {
    display: block;
    font-weight: 600;
  }

  .testimonial__role {
    display: block;
    color: var(--color-text-ondark-muted);
  }

  @media (max-width: 900px) {
    .testimonials__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
