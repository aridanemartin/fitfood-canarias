---
import { site, nav } from "../data/content";
import { useTranslations } from "../i18n";
import type { Lang } from "../i18n/locales";
import type { Alternate } from "../i18n/alternates";
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
  lang: Lang;
  alternates?: Alternate[];
}

const { lang, alternates = [] } = Astro.props;
const t = useTranslations(lang);
---

<header class="header">
  <div class="wrap header__row">
    <a class="header__brand" href="#top">
      <img src={site.logo} alt={site.name} class="header__logo" />
    </a>

    <nav class="header__nav" aria-label={t("nav.label")}>
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>{t(item.key)}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions">
      <LanguageSwitcher lang={lang} alternates={alternates} />
      <a class="btn btn--primary header__cta" href="#plans">{t("cta.viewPlans")}</a>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(20, 18, 14, 0.86);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-line);
  }

  .header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1rem;
  }

  .header__brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--color-text-ondark);
  }

  .header__logo {
    height: 50px;
    width: auto;
  }

  .header__nav ul {
    display: flex;
    gap: 1.75rem;
  }

  .header__nav a {
    text-decoration: none;
    font-size: 0.92rem;
    color: var(--color-text-ondark-muted);
    transition: color 0.15s ease;
  }

  .header__nav a:hover {
    color: var(--color-text-ondark);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  @media (max-width: 760px) {
    .header__nav {
      display: none;
    }

    .header__cta {
      padding: 0.65rem 1.1rem;
      font-size: 0.75rem;
    }
  }
</style>
