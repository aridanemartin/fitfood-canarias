---
import { differentiators } from "../data/content";
---

<section id="why-us" class="section why">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Why us</p>
      <h2>We're not a recipe app with a delivery van.</h2>
    </div>

    <div class="why__grid">
      {
        differentiators.map((item, i) => (
          <div class={`why__cell why__cell--${i} reveal`}>
            <h3 class="why__title">{item.title}</h3>
            <p class="why__text">{item.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .why__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: repeat(2, auto);
    gap: 1px;
    background: var(--color-line);
    border-radius: var(--radius-container);
    overflow: hidden;
  }

  .why__cell {
    background: var(--color-ink);
    padding: clamp(1.5rem, 2.6vw, 2rem);
  }

  /* Asymmetric spans so the grid reads as a divided tray rather than a
     uniform 4-up card row. */
  .why__cell--0 {
    grid-column: span 2;
  }

  .why__cell--1 {
    grid-column: span 2;
  }

  .why__cell--2 {
    grid-column: span 1;
  }

  .why__cell--3 {
    grid-column: span 3;
  }

  .why__title {
    font-size: 1.1rem;
  }

  .why__text {
    margin-top: 0.6rem;
    color: var(--color-text-ondark-muted);
    font-size: 0.95rem;
  }

  @media (max-width: 900px) {
    .why__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .why__cell--0,
    .why__cell--1,
    .why__cell--2,
    .why__cell--3 {
      grid-column: span 2;
    }
  }

  @media (max-width: 560px) {
    .why__grid {
      grid-template-columns: 1fr;
    }

    .why__cell--0,
    .why__cell--1,
    .why__cell--2,
    .why__cell--3 {
      grid-column: span 1;
    }
  }
</style>
