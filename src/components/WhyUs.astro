---
import { getContent } from "../data/content";
import { useTranslations } from "../i18n";
import type { Lang } from "../i18n/locales";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { differentiators } = getContent(lang);

// One stock image per differentiator cell, keyed by render order.
// All sourced from Unsplash (photo IDs noted) and stored locally so the
// page has no runtime dependency on a third-party CDN.
// Injected as a CSS custom property so the styles stay in one place.
const backgroundImages = [
  "/images/why-gender-goal.webp", // Unsplash photo-1504674900247-0877df9cc836
  "/images/why-nutritionists.webp", // Unsplash photo-1577219491135-ce391730fb2c
  "/images/why-sourced-island.webp", // Unsplash photo-1488459716781-31db52582fe9
  "/images/why-diet-aware.webp", // Unsplash photo-1512621776951-a57141f2eefd
];
---

<section id="why-us" class="section why">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{t("why.eyebrow")}</p>
      <h2>{t("why.heading")}</h2>
    </div>

    <div class="why__grid">
      {
        differentiators.map((item, i) => (
          <div
            class={`why__cell why__cell--${i} reveal`}
            style={`--why-img: url('${backgroundImages[i]}')`}
          >
            <h3 class="why__title">{item.title}</h3>
            <p class="why__text">{item.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .why__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: repeat(2, auto);
    gap: 1px;
    background: var(--color-line);
    border-radius: var(--radius-container);
    overflow: hidden;
  }

  .why__cell {
    position: relative;
    isolation: isolate; /* keeps ::before/::after above the cell background, below content */
    background: var(--color-ink);
    padding: clamp(1.5rem, 2.6vw, 2rem);
  }

  /* Background photo — barely visible at rest. */
  .why__cell::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image: var(--why-img);
    background-size: cover;
    background-position: right center;
    opacity: 0.16;
    filter: grayscale(65%) contrast(1.05);
    transition: opacity 0.45s ease, filter 0.45s ease;
  }

  /* Gradient scrim — keeps copy readable and hides the photo further. */
  .why__cell::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      105deg,
      rgb(22 22 20 / 0.88) 0%,
      rgb(22 22 20 / 0.62) 100%
    );
  }

  /* Hover (and keyboard focus) lets the photo come through. */
  .why__cell:hover::before,
  .why__cell:focus-within::before {
    opacity: 0.55;
    filter: grayscale(12%) contrast(1.02);
  }

  /* Asymmetric spans so the grid reads as a divided tray rather than a
     uniform 4-up card row. */
  .why__cell--0 {
    grid-column: span 2;
  }

  .why__cell--1 {
    grid-column: span 2;
  }

  .why__cell--2 {
    grid-column: span 1;
  }

  .why__cell--3 {
    grid-column: span 3;
  }

  .why__title {
    font-size: 1.1rem;
  }

  .why__text {
    margin-top: 0.6rem;
    color: var(--color-text-ondark-muted);
    font-size: 0.95rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .why__cell::before {
      transition: none;
    }
  }

  @media (max-width: 900px) {
    .why__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .why__cell--0,
    .why__cell--1,
    .why__cell--2,
    .why__cell--3 {
      grid-column: span 2;
    }
  }

  @media (max-width: 560px) {
    .why__grid {
      grid-template-columns: 1fr;
    }

    .why__cell--0,
    .why__cell--1,
    .why__cell--2,
    .why__cell--3 {
      grid-column: span 1;
    }
  }
</style>
