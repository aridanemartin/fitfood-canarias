---
import { useTranslations } from "../i18n";
import type { Lang } from "../i18n/locales";
import { getContent } from "../data/content";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { plans } = getContent(lang);
---

<section id="top" class="hero section section--onlight">
  <div class="hero__frame reveal">
    <img
      class="hero__bg"
      src="/images/hero-white-trays.webp"
      alt={t("hero.photoAlt")}
      loading="eager"
    />
    <div class="hero__fade" aria-hidden="true"></div>

    <div class="hero__content">
      <p class="eyebrow">{t("hero.badge")}</p>

      <h1 class="hero__headline">
        <span>{t("hero.headlineLine1")}</span>
        <span>{t("hero.headlineLine2")}</span>
      </h1>

      <p class="hero__lede">{t("hero.credential")}</p>

      <div class="hero__ctas">
        <a class="hero__cta" href="#plans">
          {t("hero.ctaPrimary")}
          <span class="hero__cta-arrow">→</span>
        </a>
        <a class="hero__cta-secondary" href="#how-it-works">{t("nav.howItWorks")}</a>
      </div>

      <ul class="hero__plans">
        {
          plans.map((plan) => (
            <li>{plan.name}</li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 0;
    padding-bottom: 0;
  }

  .hero__frame {
    position: relative;
    width: 100%;
    min-height: clamp(560px, 88vh, 840px);
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
    z-index: 0;
  }

  /* Solid white behind the copy, easing into the full photo toward the
     right — no panel, no seam, the photo just takes over as it goes. */
  .hero__fade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      90deg,
      var(--color-panel) 0%,
      var(--color-panel) 30%,
      rgba(255, 255, 255, 0.94) 38%,
      rgba(255, 255, 255, 0.55) 50%,
      rgba(255, 255, 255, 0.15) 62%,
      rgba(255, 255, 255, 0) 72%
    );
  }

  .hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-inline: var(--gutter);
    max-width: 32rem;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .hero__headline {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 0.98;
    font-size: clamp(2.2rem, 4.6vw, 3.6rem);
    color: var(--color-ink);
  }

  .hero__headline span {
    display: block;
  }

  .hero__lede {
    max-width: 34ch;
    font-size: 1.02rem;
    color: var(--color-text-onlight-muted);
  }

  .hero__ctas {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    background: var(--color-ink);
    color: var(--color-text-ondark);
    padding: 0.55rem 0.55rem 0.55rem 1.4rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-data);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform 0.15s ease;
  }

  .hero__cta:hover {
    transform: translateY(-1px);
  }

  .hero__cta-arrow {
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--color-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
  }

  .hero__cta-secondary {
    font-family: var(--font-data);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-text-onlight);
    padding: 0.85rem 1.3rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-line-onlight);
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .hero__cta-secondary:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .hero__plans {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    padding-top: 0.3rem;
  }

  .hero__plans li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-data);
    font-size: 0.8rem;
    color: var(--color-text-onlight-muted);
  }

  .hero__plans li::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__cta:hover {
      transform: none;
    }
  }

  @media (max-width: 760px) {
    .hero__frame {
      min-height: 0;
      display: block;
    }

    .hero__bg {
      position: static;
      width: 100%;
      height: 260px;
    }

    .hero__fade {
      display: none;
    }

    .hero__content {
      max-width: none;
      padding-block: clamp(1.75rem, 6vw, 2.5rem);
    }
  }
</style>
