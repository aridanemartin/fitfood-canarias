---
import { useTranslations } from "../i18n";
import type { Lang } from "../i18n/locales";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="top" class="hero section">
  <div class="hero__frame reveal">
    <img
      class="hero__bg"
      src="/images/hero-white-trays.webp"
      alt={t("hero.photoAlt")}
      loading="eager"
    />
    <div class="hero__scrim"></div>

    <div class="wrap hero__content">
      <h1 class="hero__headline">
        <span>{t("hero.word1")}</span>
        <span class="accent">{t("hero.word2")}</span>
        <span>{t("hero.word3")}</span>
      </h1>

      <div class="hero__foot">
        <div class="hero__credential">
          <p class="hero__badge">{t("hero.badge")}</p>
          <p>{t("hero.credential")}</p>
          <a class="hero__cta" href="#plans">
            {t("hero.ctaPrimary")}
            <span class="hero__cta-arrow">→</span>
          </a>
        </div>
        <a class="hero__scrollhint" href="#how-it-works" aria-label={t("hero.scrollLabel")}>
          ↓
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 0;
  }

  /* The hero is one large, full-bleed photo "frame" with a giant
     stacked headline over it. */
  .hero__frame {
    position: relative;
    width: 100%;
    height: clamp(420px, 82vh, 760px);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 38%;
    z-index: 0;
  }

  /* A light wash rather than a dark scrim — the photo is bright to begin
     with, this just nudges up contrast behind the headline and footer. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(100deg, rgba(255, 255, 255, 0) 30%, rgba(255, 255, 255, 0.5) 58%, rgba(255, 255, 255, 0.72) 100%),
      linear-gradient(0deg, rgba(255, 255, 255, 0.88) 0%, rgba(255, 255, 255, 0) 34%);
  }

  /* Positioning context for the headline/footer, capped to the same
     max-width as the sections below instead of the full-bleed photo. */
  .hero__content {
    position: absolute;
    inset: 0;
  }

  .hero__headline {
    position: absolute;
    z-index: 2;
    left: 8%;
    right: 0;
    top: 14%;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    text-align: right;
    line-height: 0.92;
    color: var(--color-ink);
  }

  .hero__headline span {
    display: block;
    font-size: clamp(2rem, 6vw, 4.5rem);
    letter-spacing: -0.01em;
  }

  .hero__headline .accent {
    color: var(--accent);
  }

  .hero__foot {
    position: absolute;
    z-index: 3;
    left: 0;
    right: 0;
    bottom: clamp(1.4rem, 3.5vw, 2.2rem);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
  }

  /* A translucent card — the photo is too busy in places for the dark
     text to stay reliably readable directly on top of it. */
  .hero__credential {
    max-width: 26rem;
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(8px);
    padding: 1.1rem 1.3rem;
    border-radius: var(--radius-container);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.14);
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-data);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink);
    margin-bottom: 0.6rem;
  }

  .hero__badge::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  .hero__credential p:not(.hero__badge) {
    font-size: 0.9rem;
    color: var(--color-text-onlight);
    max-width: 40ch;
    margin-bottom: 1.1rem;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    background: var(--color-ink);
    color: var(--color-text-ondark);
    padding: 0.55rem 0.55rem 0.55rem 1.4rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-data);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .hero__cta-arrow {
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--color-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
  }

  .hero__scrollhint {
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 50%;
    border: 1px solid rgba(22, 22, 20, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-ink);
    font-size: 1.1rem;
    flex-shrink: 0;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .hero__scrollhint:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  @media (max-width: 760px) {
    .hero__frame {
      height: clamp(480px, 78vh, 640px);
    }

    .hero__headline {
      left: 6%;
      right: 6%;
      top: 8%;
      text-align: left;
    }

    .hero__headline span {
      font-size: clamp(1.9rem, 9vw, 2.6rem);
    }

    .hero__foot {
      flex-direction: column;
      align-items: flex-start;
    }

    .hero__scrollhint {
      display: none;
    }
  }
</style>
