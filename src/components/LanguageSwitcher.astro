---
import { activeLocales, localeConfig, type Lang } from "../i18n/locales";
import { localizedUrl, useTranslations } from "../i18n";
import type { Alternate } from "../i18n/alternates";

/* ------------------------------------------------------------------ *
 * Header language selector.
 *
 * One entry per active locale, labelled by flag rather than by text —
 * the same pattern used in how-to-prepare-your-coffee and
 * buceo-sur-gc. An entry links to the page's own reciprocal alternate
 * where one exists; otherwise it falls back to that locale's home, so
 * the control is always usable and never points at a page that was
 * never built.
 *
 * A single active locale means there is nothing to switch between, so
 * the whole control stays out of the DOM.
 * ------------------------------------------------------------------ */

interface Props {
  lang: Lang;
  /** Reciprocal pairs from alternatesFor(); absent on pages without them. */
  alternates?: Alternate[];
}

const { lang, alternates = [] } = Astro.props;
const t = useTranslations(lang);

/**
 * One flag per locale. English is represented by the Union Jack, matching
 * the convention this switcher mirrors. `Record<Lang, ...>` means adding a
 * locale without adding its flag here is a typecheck error, not a silently
 * blank icon.
 */
const FLAG_IMAGES: Record<Lang, string> = {
  es: "/flags/es.webp",
  en: "/flags/gb.webp",
};

const options = activeLocales().map((code) => ({
  lang: code,
  label: localeConfig(code).label,
  flag: FLAG_IMAGES[code],
  href:
    alternates.find((alt) => alt.lang === code)?.href ??
    localizedUrl(code, { kind: "home" }),
  current: code === lang,
}));
---

{
  options.length > 1 && (
    <details class="lang-switcher">
      <summary aria-label={`${t("lang.label")}: ${localeConfig(lang).label}`}>
        <img class="lang-flag" src={FLAG_IMAGES[lang]} alt="" width="20" height="20" />
        <svg
          width="10"
          height="10"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <polyline points="6 9 12 15 18 9" />
        </svg>
      </summary>
      <ul class="lang-menu">
        {options.map((option) => (
          <li>
            <a
              class:list={["lang-option", { "is-current": option.current }]}
              href={option.href}
              hreflang={option.lang}
              aria-current={option.current ? "true" : undefined}
            >
              <img
                class="lang-flag"
                src={option.flag}
                alt=""
                width="20"
                height="20"
              />
              <span>{option.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </details>
  )
}

<script>
  /* Close the menu on an outside click or Escape. The control is a plain
   * <details>, so it stays fully usable without this — the script only makes
   * dismissal feel native. */
  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Node)) return;
    document
      .querySelectorAll("details.lang-switcher[open]")
      .forEach((details) => {
        if (!details.contains(target)) details.removeAttribute("open");
      });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    document
      .querySelectorAll("details.lang-switcher[open]")
      .forEach((details) => details.removeAttribute("open"));
  });
</script>

<style>
  .lang-switcher {
    position: relative;
  }

  .lang-switcher summary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0;
    font-family: var(--font-data);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-ondark-muted);
    cursor: pointer;
    user-select: none;
    list-style: none;
  }

  .lang-switcher summary::-webkit-details-marker {
    display: none;
  }

  .lang-switcher summary:hover,
  .lang-switcher[open] summary {
    color: var(--color-text-ondark);
  }

  .lang-switcher summary svg {
    transition: transform 0.2s ease;
  }

  .lang-switcher[open] summary svg {
    transform: rotate(180deg);
  }

  .lang-flag {
    width: 20px;
    height: 20px;
    flex: none;
    border-radius: 2px;
    object-fit: cover;
  }

  .lang-menu {
    position: absolute;
    top: calc(100% + 0.6rem);
    inset-inline-end: 0;
    z-index: 60;
    min-width: 9rem;
    margin: 0;
    padding: 0.4rem 0;
    list-style: none;
    background: var(--color-ink-raised);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-container);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.45);
  }

  .lang-option {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 1rem;
    font-family: var(--font-data);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--color-text-ondark-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .lang-option:hover,
  .lang-option:focus-visible {
    background: rgba(255, 255, 255, 0.06);
    color: var(--color-text-ondark);
  }

  .lang-option.is-current {
    color: var(--accent);
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    .lang-switcher summary svg {
      transition: none;
    }
  }
</style>
