---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Plans from "../components/Plans.astro";
import Founder from "../components/Founder.astro";
import WhyUs from "../components/WhyUs.astro";
import Testimonials from "../components/Testimonials.astro";
import BlogTeaser from "../components/BlogTeaser.astro";
import ContactCTA from "../components/ContactCTA.astro";
import Footer from "../components/Footer.astro";
import { alternatesFor } from "../i18n/alternates";
import { useTranslations } from "../i18n";
import type { Lang } from "../i18n/locales";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const alternates = alternatesFor();
---

<BaseLayout
  title={t("site.title")}
  description={t("site.description")}
  lang={lang}
  alternates={alternates}
>
  <Header lang={lang} alternates={alternates} />
  <main>
    <Hero lang={lang} />
    <div class="tray-divider"></div>
    <HowItWorks lang={lang} />
    <Plans lang={lang} />
    <Founder lang={lang} />
    <div class="tray-divider"></div>
    <WhyUs lang={lang} />
    <Testimonials lang={lang} />
    <BlogTeaser lang={lang} />
    <div class="tray-divider"></div>
    <ContactCTA lang={lang} />
  </main>
  <Footer lang={lang} />
</BaseLayout>
